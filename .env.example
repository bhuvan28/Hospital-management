# =============================================================================
# RMH HCTM UKM Operations Platform — environment template
# Copy to .env and replace every CHANGE_ME value before starting services.
# Never commit a real .env file.
# =============================================================================

# --- Application ---
APP_NAME=RMH HCTM UKM Operations Platform
APP_ENV=development
# production | development | test
DEBUG=false
LOG_LEVEL=INFO

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:3000

# Generate a long random string for production, e.g.:
# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Set COOKIE_SECURE=true and use HTTPS in production.

# --- Database ---
# Use localhost when the backend runs on the host (uvicorn, Alembic, Cloud Agents).
# Docker Compose overrides this to `postgres` for the backend container only.
# Do not use the compose service name here or psycopg fails with "Name or service not known".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rmh_hctm
POSTGRES_USER=rmh
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
# Assembled automatically by the backend if DATABASE_URL is omitted.
# DATABASE_URL=postgresql+psycopg://rmh:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/rmh_hctm

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=RMH HCTM UKM

# --- Seed (development only) ---
# Seed users are DEVELOPMENT ONLY. Disable in production.
SEED_ON_STARTUP=true
# Fictional sample families/finance rows for local dashboards. Never real people.
SEED_DEMO_RECORDS=true
SEED_ADMIN_EMAIL=admin@rmh.example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_DEV_ADMIN_PASSWORD

# --- Backups ---
BACKUP_DIR=/backups
